{
  "name": "@CustomerDeskAI/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "auth:gen": "pnpm dlx @better-auth/cli@latest generate --config ../auth/src/index.ts --output ./src/schema/auth.ts -y",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "@types/pg": "catalog:",
    "typescript": "^5",
    "@CustomerDeskAI/config": "workspace:*"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.16.3",
    "dotenv": "catalog:",
    "zod": "catalog:"
  }
}
